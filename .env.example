# Sales follow-up questionnaire (/s/[token]) — server-only secrets.
# Same Supabase project the app uses. Schema:
# tavnit-nextjs/supabase/migrations/20260815120000_followup_invites.sql
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Where the final "schedule your demo" button points (Calendly/Cal.com/etc.).
# Optional — falls back to a mailto link to SALES_EMAIL (src/lib/site.ts).
FOLLOWUP_SCHEDULER_URL=
