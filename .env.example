# Sales follow-up questionnaire (/s/[token]) — server-only secrets.
# Same Supabase project the app uses. Schema:
# supabase/migrations/ in this repo (followup_invites + platform_admins columns)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Global fallback for the final "schedule your demo" button. Per-rep booking
# links (set in tavnit-admin → Settings → Admins) take precedence; with
# neither, the button falls back to a mailto to the rep.
FOLLOWUP_SCHEDULER_URL=

# Optional: lets /schedule verify the booked meeting's start time against the
# Calendly API (personal access token from calendly.com → Integrations → API).
# Without it the time reported by the embed is stored as-is.
CALENDLY_API_TOKEN=

# Instant "prospect finished the questionnaire" email to the sales rep.
# Optional — without MAILGUN_API_KEY the questionnaire works and the email is
# skipped. Same Mailgun account and env names tavnit-flask uses.
MAILGUN_API_KEY=
# Defaults: MAILGUN_DOMAIN=mg.tavnit.io, MAILGUN_BASE_URL=https://api.mailgun.net/v3,
# FOLLOWUP_FROM_EMAIL="Tavnit <no-reply@mg.tavnit.io>"
MAILGUN_DOMAIN=
FOLLOWUP_FROM_EMAIL=
# Base URL of the tavnit-admin deployment, used to deep-link the email to the
# lead's detail page. Optional.
FOLLOWUP_ADMIN_URL=

# Google Analytics 4 measurement id for the tavnit.io data stream (G-XXXXXXXXXX).
# Leave empty to disable analytics and the cookie banner entirely (local dev).
NEXT_PUBLIC_GA_ID=
