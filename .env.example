# Sales follow-up questionnaire (/s/[token]) — server-only secrets.
# Same Supabase project the app uses. Schema:
# supabase/migrations/ in this repo (followup_invites + platform_admins columns)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Global fallback for the final "schedule your demo" button. Per-rep booking
# links (set in tavnit-admin → Settings → Admins) take precedence; with
# neither, the button falls back to a mailto to the rep.
FOLLOWUP_SCHEDULER_URL=

# Optional: lets /schedule verify the booked meeting's start time against the
# Calendly API (personal access token from calendly.com → Integrations → API).
# Without it the time reported by the embed is stored as-is.
CALENDLY_API_TOKEN=

# Instant "prospect finished the questionnaire" email to the sales rep.
# Optional — without MAILGUN_API_KEY the questionnaire works and the email is
# skipped. Same Mailgun account and env names tavnit-flask uses.
MAILGUN_API_KEY=
# Defaults: MAILGUN_DOMAIN=mg.tavnit.io, MAILGUN_BASE_URL=https://api.mailgun.net/v3,
# FOLLOWUP_FROM_EMAIL="Tavnit <no-reply@mg.tavnit.io>"
MAILGUN_DOMAIN=
FOLLOWUP_FROM_EMAIL=
# Base URL of the tavnit-admin deployment, used to deep-link the email to the
# lead's detail page. Optional.
FOLLOWUP_ADMIN_URL=

# Google Analytics 4 measurement id for the tavnit.io data stream (G-XXXXXXXXXX).
# Leave empty to disable analytics and the cookie banner entirely (local dev).
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Tavnit Lite — free tools under /tools and /es/herramientas.
# The tools run inside a dedicated "Tavnit Lite" org in the product; the
# landing calls the existing Tavnit API with that org's key (server-only) and
# a fixed flow per tool. Runs are recorded in lite_runs (migration in this
# repo) for quota, ownership and the download lead.
TAVNIT_API_URL=https://run.tavnit.io
TAVNIT_LITE_API_KEY=1914d426-246a-47f4-b76d-9d643a1e481c
# Flow ids inside the Lite org, one per tool and language (field names are the
# column names the visitor sees). The English id is optional; it falls back
# to the Spanish flow.
TAVNIT_LITE_INVOICE_FLOW_ID=
TAVNIT_LITE_INVOICE_FLOW_ID_EN=
# Random string. Visitor IPs are stored only as an HMAC with this salt.
LITE_IP_SALT=
# Global runs/day across all visitors (protects the Lite org's credits).
LITE_DAILY_CAP=500
# Retention: documents and results of free-tool runs are deleted after this
# many hours by the hourly lite-cleanup cron (vercel.json). Default 24.
LITE_RETENTION_HOURS=24
# The Lite org's id: the cleanup refuses to delete anything outside it.
TAVNIT_LITE_ORG_ID=
# Shared secret for the cron route (Authorization: Bearer). Vercel sends it
# automatically when CRON_SECRET is set on the project.
CRON_SECRET=
# Cloudflare Turnstile (required for launch; without the secret the check is
# skipped and only the per-session/IP/global quotas apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Supabase Auth for the download step (same project; anon key is public).
# Add https://www.tavnit.io/auth/callback to Supabase → Auth → Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
